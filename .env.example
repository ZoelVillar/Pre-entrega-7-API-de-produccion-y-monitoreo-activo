# Copiá este archivo como .env y completá tus claves.

# --- Orquestador (Entrega 6) --------------------------------------------------

# Clave de API de Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Clave de API de Tavily (free tier disponible): https://app.tavily.com/home
TAVILY_API_KEY=tvly-...

# Modelo de Anthropic a usar (opcional, default: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Tope de pasos del Supervisor antes de forzar FINISH (opcional, default: 6)
MAX_SUPERVISOR_STEPS=6

# Techo de recursión del grafo por invocación (opcional, default: 15)
RECURSION_LIMIT=15

# Cantidad máxima de resultados que devuelve Tavily por búsqueda (opcional, default: 5)
TAVILY_MAX_RESULTS=5

# --- API y persistencia (Entrega 7) -------------------------------------------

# Redis 8+ (RedisJSON + RediSearch). Con docker compose, el servicio api pisa
# este valor por redis://redis:6379; este default es para correr uvicorn local.
REDIS_URL=redis://localhost:6379

# --- Observabilidad: LangSmith ------------------------------------------------

# En "true" para enviar trazas. En "false" la API arranca igual, sin observabilidad.
LANGCHAIN_TRACING_V2=true

# Clave de LangSmith: https://smith.langchain.com/settings
LANGCHAIN_API_KEY=lsv2_pt_...

# Proyecto donde agrupar las trazas (opcional, default: entrega-7-orquestador)
LANGCHAIN_PROJECT=entrega-7-orquestador
